    {
      "name": "settings",
      "description": "Read or update web owned memory preferences. Omitted fields keep their values; provider null disables memory.",
      "visibility": [
        "owner"
      ],
      "idempotent": true,
      "parameters": {
        "type": "object",
        "properties": {
          "settings": {
            "type": "string",
            "description": "JSON partial preferences: provider (app slug or null), autoRecall and autoRetain (booleans)."
          }
        }
      },
      "output": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "provider",
              "autoRecall",
              "autoRetain"
            ],
            "properties": {
              "provider": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "autoRecall": {
                "type": "boolean"
              },
              "autoRetain": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "ignored"
            ],
            "properties": {
              "ignored": {
                "const": "no caller"
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
