    {
      "name": "component-set",
      "description": "Register trusted same-page ESM for the active caller. No CSS isolation: scope selectors under an app root; inherit --fg/--bg/--card (not --foreground/--background). Host header/section rules affect components. Call web.catalog for theme/layout/testing rules; complete activated JS/CSS example ships in Web source UI-DEVELOPMENT.md. Use returned type verbatim, then re-register pages. Prefer shared declarative components unless browser APIs are needed.",
      "visibility": [
        "modules"
      ],
      "idempotent": true,
      "parameters": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "javascript": {
            "type": "string",
            "description": "Self-contained ESM without imports. Default synchronous mount(element,{props,emit,call,children?,slots?}) returns cleanup or {update?,destroy?}, not Promise. Trusted same-origin code; release listeners/media/URLs on destroy. Activated example: source UI-DEVELOPMENT.md; rules: web.catalog."
          },
          "css": {
            "type": "string",
            "description": "Same-document CSS, no isolation. Scope all selectors under an app root; host header/section styles enter components. Pair --fg with --card/--bg; dark mode uses prefers-color-scheme. No global body/:root/tag rules. Full collision/theme rules: web.catalog and source UI-DEVELOPMENT.md."
          },
          "props": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "Strict object JSON schema with type, properties, required and additionalProperties:false. Web validates supported keywords and bounds."
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "slots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "javascript",
          "props"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "Exact page element type with the actual caller module prefix, such as music:Player. Use this value verbatim."
          },
          "revision": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "type",
          "revision"
        ],
        "additionalProperties": false
      },
      "examples": [
        {
          "description": "Minimal same-page scoped panel; use returned type in page-set. Complete activated registration and cleanup example: UI-DEVELOPMENT.md.",
          "args": {
            "name": "Player",
            "javascript": "export default function mount(element){const root=document.createElement('div');root.className='music-panel';root.textContent='音乐';element.append(root);return ()=>root.remove();}",
            "css": ".music-panel { color:var(--fg); background:var(--card); min-width:0; overflow-wrap:anywhere; }",
            "props": {
              "type": "object",
              "properties": {},
              "additionalProperties": false
            }
          }
        }
      ]
    },
    {
      "name": "component-remove",
      "description": "Remove a component owned by the real active approved caller. Dependent pages become unavailable.",
      "visibility": [
        "modules"
      ],
      "idempotent": true,
      "parameters": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "removed": {
            "type": "boolean"
          }
        },
        "required": [
          "removed"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "page-set",
      "output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "catalog": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "catalog"
        ],
        "additionalProperties": false
      },
      "description": "Register a caller-owned page on every activation. Prefer shared catalog components or declarative templates; use exact component-set returned type for browser controls. layout controls content, shell/theme stay Web-owned. Call web.catalog for theme, CSS collision, height and validation rules; full activated example: version source UI-DEVELOPMENT.md. Props/events/slots, active hash, revision and declared own tool contracts are checked and pinned.",
      "visibility": [
        "modules"
      ],
      "idempotent": true,
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Page slug, e.g. main"
          },
          "title": {
            "type": "string"
          },
          "layout": {
            "type": "string",
            "enum": [
              "document",
              "workspace"
            ],
            "description": "document: centered max-width 64rem and padding; workspace: full main width without padding, still inside host navigation. Only shared Workspace computes remaining viewport height; arbitrary components must size themselves. Avoid fixed 900px/100vh assumptions. See web.catalog and UI-DEVELOPMENT.md."
          },
          "components": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "App-private declarative templates keyed by the actual caller module name plus :Name (for example music:Card); app is only a placeholder. See web.catalog."
          },
          "content": {
            "type": "object",
            "properties": {
              "tool": {
                "type": "string"
              }
            },
            "required": [
              "tool"
            ],
            "additionalProperties": false,
            "description": "Own visible tool accepting {ref}, returning null or {base64,mime} for bounded raster images; see web.catalog."
          },
          "data": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "{ name: { tool, args?, refresh? } }"
          },
          "spec": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "json-render spec { root, elements }"
          },
          "purpose": {
            "type": "string",
            "enum": [
              "settings"
            ],
            "description": "Marks this app-owned settings page for navigation; at most one settings page per app."
          }
        },
        "required": [
          "id",
          "title",
          "spec"
        ]
      }
    },
    {
      "name": "page-remove",
      "output": {
        "type": "object",
